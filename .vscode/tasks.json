{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Backend: build",
      "type": "shell",
      "command": "npm run build",
      "options": {
        "cwd": "${workspaceFolder}/backend",
        "env": {}
      },
      "group": "build",
      "presentation": {
        "reveal": "silent",
        "panel": "shared"
      }
    },
    {
      "label": "Backend: build (Node 24)",
      "type": "shell",
      "command": "npm run build",
      "options": {
        "cwd": "${workspaceFolder}/backend",
        "env": {
          "PATH": "${env:HOME}/.nvm/versions/node/v24.13.0/bin:${env:PATH}"
        }
      },
      "group": "build",
      "presentation": {
        "reveal": "silent",
        "panel": "shared"
      }
    }
  ]
}
